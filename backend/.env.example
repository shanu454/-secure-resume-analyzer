# For running the backend directly (no Docker). Copy to backend/.env
ENVIRONMENT=dev
# SQLite works out of the box; for PostgreSQL use e.g.
# DATABASE_URL=postgresql+psycopg2://resume:password@localhost:5432/resume_analyzer
DATABASE_URL=sqlite:///./dev.db
SECRET_KEY=dev-only-secret-change-me-dev-only-secret
CORS_ORIGINS=http://localhost:5173
RETENTION_DAYS=30
